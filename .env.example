# Copy to .env and fill in. Never commit .env.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GITHUB_TOKEN=            # optional but avoids GitHub rate limits (60/hr without it)

# LiteLLM model strings: swap providers without code changes
READER_MODEL=anthropic/claude-sonnet-5-5
READER_MODEL_CHEAP=anthropic/claude-haiku-5-5
MAX_PAPER_CHARS=120000
